import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";

export struct MappingRow {
    windows: string,
    unix: string,
}

export struct CheckRow {
    id: string,
    label: string,
    enabled: bool,
}

export struct ScanRow {
    path: string,
    remote: string,
    kind-text: string,
    kind: int,
    checked: bool,
    known: bool,
}

export struct BarItem {
    label: string,
    value: int,
    frac: float,
}

export struct HeatItem {
    col: int,
    row: int,
    level: int,
}

export struct ViewRow {
    key: string,
    name: string,
    count: int,
    selected: bool,
    custom: bool,
}

export struct InfoRow {
    label: string,
    text: string,
    advice: string,
    kind: int,
}

export struct TaskRow {
    title: string,
    state: int,
    detail: string,
}

export struct DirtyLocFilterItem {
    id: string,
    label: string,
    count: int,
}

export struct DirtyFileRow {
    path: string,
    status: string,
    status-code: string,
    kind: int,
    mtime-text: string,
    size-text: string,
    loc-label: string,
    loc-id: string,
    loc-path: string,
}

export struct LocationRow {
    id: string,
    can-pull: bool,
    can-push: bool,
    can-commit: bool,
    can-clean: bool,
    build-size: string,
    label: string,
    path: string,
    role: string,
    status: string,
    error-msg: string,
    kind: int,
    branch: string,
    ahead: int,
    behind: int,
    dirty: int,
    stashes: int,
    working-tree: string,
    working-tree-kind: int,
    fetched: string,
    pulled: string,
    last-dirty-time: string,
    other-os: bool,
    dirty-files: [DirtyFileRow],
}

export struct MissingBasePathRow {
    label: string,
    target-path: string,
    base-kind: string,
}

export struct SmartSyncDetailRow {
    title: string,
    path: string,
    info: string,
    files: [string],
    kind: int,
}

export struct SmartSyncLogRow {
    state: int,
    action: string,
    repo: string,
    path: string,
    detail: string,
}

export struct RepoRow {
    id: string,
    name: string,
    remote: string,
    tags: string,
    status: string,
    error-msg: string,
    kind: int,
    branch: string,
    last-commit: string,
    last-commit-time: string,
    last-commit-hash: string,
    last-commit-author: string,
    last-commit-msg: string,
    commits: string,
    files: string,
    size: string,
    size-kind: int,
    build-size: string,
    build-kind: int,
    locations: int,
    locations-preview: string,
    favorite: bool,
    has-drift: bool,
    ahead-count: int,
    behind-count: int,
    dirty-count: int,
    stash-count: int,
    can-clean: bool,
    dirty-files-preview: string,
}

global Kinds {
    pure public function kind-color(kind: int) -> color {
        return kind == 0 ? #2e9e5b : kind == 1 ? #2a7fd4 : kind == 2 ? #d98e04 : kind == 3 ? #e04347 : #808080;
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    background: Kinds.kind-color(kind).with-alpha(0.18);
    border-radius: 10px;
    border-color: Kinds.kind-color(kind);
    border-width: 1px;
    min-width: label.preferred-width + 14px;
    height: 20px;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Kinds.kind-color(root.kind);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ColSep inherits Rectangle {
    width: 1px;
    background: #80808022;
}

component BarChart inherits Rectangle {
    in property <[BarItem]> items;
    in property <color> bar-color: #2a7fd4;
    height: 110px;
    HorizontalLayout {
        spacing: 3px;
        for it in root.items: VerticalLayout {
            Rectangle {
                Rectangle {
                    y: parent.height * (1 - it.frac);
                    height: parent.height * it.frac;
                    width: parent.width;
                    background: root.bar-color;
                    border-radius: 2px;
                }
                Text {
                    y: Math.max(0px, parent.height * (1 - it.frac) - 12px);
                    width: parent.width;
                    text: it.value > 0 ? it.value : "";
                    font-size: 9px;
                    horizontal-alignment: center;
                }
            }
            Text { text: it.label; font-size: 9px; horizontal-alignment: center; overflow: elide; height: 12px; opacity: 0.7; }
        }
    }
}

component Heatmap inherits Rectangle {
    in property <[HeatItem]> cells;
    width: 53 * 7px;
    height: 7 * 7px;
    for c in root.cells: Rectangle {
        x: c.col * 7px;
        y: c.row * 7px;
        width: 6px;
        height: 6px;
        border-radius: 1px;
        background: c.level == 0 ? #80808030 : c.level == 1 ? #2e9e5b55 : c.level == 2 ? #2e9e5b88 : c.level == 3 ? #2e9e5bbb : #2e9e5b;
    }
}

component AuthorBars inherits Rectangle {
    in property <[BarItem]> items;
    height: max(20px, root.items.length * 22px);
    VerticalLayout {
        spacing: 2px;
        for a in root.items: Rectangle {
            height: 20px;
            background: #80808014;
            border-radius: 3px;
            Rectangle {
                x: 0;
                width: parent.width * a.frac;
                background: #2a7fd455;
                border-radius: 3px;
            }
            Text { x: 6px; text: a.label; font-size: 11px; vertical-alignment: center; overflow: elide; width: parent.width - 50px; }
            Text { x: parent.width - 40px; width: 34px; text: a.value; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
}

export component ScanWindow inherits Window {
    title: "RepoOrganizer – Scan-Assistent";
    min-width: 860px;
    min-height: 580px;
    preferred-width: 920px;
    preferred-height: 640px;

    in property <[ScanRow]> scan-rows;
    in property <bool> scanning;
    in property <string> scan-progress;
    in-out property <string> scan-roots: "";

    public function apply-theme(t: string) {
        Palette.color-scheme = t == "dark" ? ColorScheme.dark : t == "light" ? ColorScheme.light : ColorScheme.unknown;
    }

    callback scan-start(string, string);
    callback scan-cancel();
    callback scan-toggle(int);
    callback scan-adopt();
    callback browse-roots();
    callback close-window();

    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Scan-Assistent"; font-size: 19px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
            Button { text: "Schließen"; clicked => { root.close-window(); } }
        }
        Text {
            text: "Wurzelordner (mehrere mit ; trennen) und maximale Tiefe wählen. Gefundene Git-Repositories werden automatisch mit der Konfiguration abgeglichen.";
            font-size: 12px;
            opacity: 0.75;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            roots-edit := LineEdit {
                text <=> root.scan-roots;
                placeholder-text: "z. B. R:\\git; D:\\projekte";
                horizontal-stretch: 1;
            }
            Button {
                text: "Ordner wählen…";
                enabled: !root.scanning;
                clicked => { root.browse-roots(); }
            }
            Text { text: "Tiefe:"; font-size: 12px; vertical-alignment: center; }
            depth-edit := LineEdit { text: "4"; width: 60px; input-type: number; }
            Button {
                text: root.scanning ? "Abbrechen" : "Scannen";
                primary: !root.scanning;
                enabled: root.scanning || root.scan-roots != "";
                clicked => {
                    if (root.scanning) { root.scan-cancel(); } else { root.scan-start(root.scan-roots, depth-edit.text); }
                }
            }
        }
        Text { text: root.scan-progress; font-size: 12px; opacity: 0.75; overflow: elide; }
        Rectangle {
            min-height: 280px;
            vertical-stretch: 1;
            border-width: 1px;
            border-color: #80808030;
            border-radius: 6px;
            background: #80808008;
            ListView {
                for row[i] in root.scan-rows: Rectangle {
                    height: 46px;
                    background: ta2.has-hover ? #80808018 : (Math.mod(i, 2) == 1 ? #8080800a : transparent);
                    ta2 := TouchArea { enabled: !row.known; clicked => { root.scan-toggle(i); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        CheckBox { checked: row.checked; enabled: !row.known; toggled => { root.scan-toggle(i); } }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: row.path; font-weight: 600; overflow: elide; }
                            Text { text: row.remote == "" ? "(kein origin)" : row.remote; font-size: 11px; opacity: 0.65; overflow: elide; }
                        }
                        Badge { text: row.kind-text; kind: row.kind; y: (parent.height - self.height) / 2; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Auswahl übernehmen";
                enabled: !root.scanning && root.scan-rows.length > 0;
                primary: true;
                clicked => { root.scan-adopt(); }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "RepoOrganizer – Programmeinstellungen";
    min-width: 920px;
    min-height: 640px;
    preferred-width: 980px;
    preferred-height: 700px;

    in-out property <string> cfg-theme;
    in-out property <string> cfg-git-user;
    in-out property <string> cfg-git-path;
    in-out property <string> cfg-refresh-secs;
    in-out property <string> cfg-timeout-secs;
    in-out property <string> cfg-stale-days;
    in-out property <string> cfg-shared-win;
    in-out property <string> cfg-shared-unix;
    in-out property <string> cfg-local-linux;
    in-out property <string> cfg-local-win;
    in property <[MappingRow]> cfg-mappings;
    in property <[CheckRow]> cfg-checks;

    public function apply-theme(t: string) {
        Palette.color-scheme = t == "dark" ? ColorScheme.dark : t == "light" ? ColorScheme.light : ColorScheme.unknown;
    }

    callback theme-changed(string);
    callback save-settings(string, string, string, string, string, string, string, string, string, string);
    callback browse-base-path(string);
    callback add-mapping(string, string);
    callback remove-mapping(int);
    callback toggle-health-check(string);
    callback close-window();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Programmeinstellungen"; font-size: 19px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
            Button {
                text: "Speichern & Schließen";
                primary: true;
                clicked => {
                    root.save-settings(root.cfg-theme, root.cfg-git-user, root.cfg-git-path, root.cfg-refresh-secs, root.cfg-timeout-secs, root.cfg-stale-days, root.cfg-shared-win, root.cfg-shared-unix, root.cfg-local-linux, root.cfg-local-win);
                    root.close-window();
                }
            }
            Button { text: "Schließen"; clicked => { root.close-window(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;
                alignment: start;
                HorizontalLayout {
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        Text { text: "Allgemein (local.toml)"; font-weight: 700; font-size: 14px; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Darstellung (Theme):"; width: 190px; vertical-alignment: center; }
                            Button {
                                text: "System";
                                primary: root.cfg-theme == "system";
                                clicked => {
                                    root.cfg-theme = "system";
                                    root.apply-theme("system");
                                    root.theme-changed("system");
                                }
                            }
                            Button {
                                text: "Hell";
                                primary: root.cfg-theme == "light";
                                clicked => {
                                    root.cfg-theme = "light";
                                    root.apply-theme("light");
                                    root.theme-changed("light");
                                }
                            }
                            Button {
                                text: "Dunkel";
                                primary: root.cfg-theme == "dark";
                                clicked => {
                                    root.cfg-theme = "dark";
                                    root.apply-theme("dark");
                                    root.theme-changed("dark");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Git-User / Account:"; width: 190px; vertical-alignment: center; }
                            LineEdit {
                                text <=> root.cfg-git-user;
                                placeholder-text: "z. B. mein-user (leitet https://github.com/<user>/<repo>.git ab)";
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Git-Pfad (leer = git):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-git-path; placeholder-text: "git"; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Auto-Refresh (Sek., 0=aus):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-refresh-secs; input-type: number; width: 110px; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Timeout Erreichbarkeit (Sek.):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-timeout-secs; input-type: number; width: 110px; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Veraltet nach (Tage):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-stale-days; input-type: number; width: 110px; }
                        }
                        Text { text: "Standard-Basispfade (repos.toml / Hauptkonfig)"; font-weight: 700; font-size: 14px; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Geteilt Unix (z. B. /r/git):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-shared-unix; placeholder-text: "/r/git"; horizontal-stretch: 1; }
                            Button { text: "Wählen…"; clicked => { root.browse-base-path("shared_unix"); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Geteilt Windows (z. B. R:\\git):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-shared-win; placeholder-text: "R:\\git"; horizontal-stretch: 1; }
                            Button { text: "Wählen…"; clicked => { root.browse-base-path("shared_win"); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Lokal Linux (z. B. ~/Projekte):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-local-linux; placeholder-text: "/home/.../Projekte"; horizontal-stretch: 1; }
                            Button { text: "Wählen…"; clicked => { root.browse-base-path("local_linux"); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Lokal Windows (z. B. C:\\Projekte):"; width: 190px; vertical-alignment: center; }
                            LineEdit { text <=> root.cfg-local-win; placeholder-text: "C:\\Projekte"; horizontal-stretch: 1; }
                            Button { text: "Wählen…"; clicked => { root.browse-base-path("local_win"); } }
                        }

                        Text { text: "Pfad-Mappings Windows ↔ Linux/macOS (repos.toml)"; font-weight: 700; font-size: 14px; }
                        HorizontalLayout {
                            spacing: 6px;
                            mw := LineEdit { placeholder-text: "Windows, z. B. R:\\"; horizontal-stretch: 1; }
                            mu := LineEdit { placeholder-text: "Unix, z. B. /mnt/r/"; horizontal-stretch: 1; }
                            Button {
                                text: "Hinzufügen";
                                enabled: mw.text != "" && mu.text != "";
                                clicked => { root.add-mapping(mw.text, mu.text); mw.text = ""; mu.text = ""; }
                            }
                        }
                        for m[idx] in root.cfg-mappings: HorizontalLayout {
                            spacing: 8px;
                            Text { text: m.windows + "  ↔  " + m.unix; vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: "Entfernen"; clicked => { root.remove-mapping(idx); } }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        width: 320px;
                        Text { text: "Aktive Health-Checks"; font-weight: 700; font-size: 14px; }
                        for chk in root.cfg-checks: CheckBox {
                            text: chk.label;
                            checked: chk.enabled;
                            toggled => { root.toggle-health-check(chk.id); }
                        }
                    }
                }
            }
        }
    }
}

component SmartSyncDetailItem inherits Rectangle {
    in property <SmartSyncDetailRow> item;
    property <bool> files-open: false;

    background: #80808014;
    border-width: 1px;
    border-color: #80808024;
    border-radius: 5px;
    clip: true;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        HorizontalLayout {
            height: 24px;
            spacing: 8px;

            Text {
                text: root.item.title;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 24px;
                clip: true;
                Text {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.item.path;
                    font-size: 11px;
                    opacity: 0.75;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.item.files.length > 0: Rectangle {
                height: 20px;
                min-width: files-toggle-txt.preferred-width + 14px;
                background: files-ta.has-hover ? #2a7fd433 : #80808022;
                border-width: 1px;
                border-color: root.files-open ? #2a7fd488 : #80808044;
                border-radius: 4px;
                files-toggle-txt := Text {
                    text: (root.files-open ? "▼ " : "▶ ") + root.item.files.length + (root.item.files.length == 1 ? " Datei" : " Dateien");
                    font-size: 11px;
                    font-weight: 600;
                    color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                files-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.files-open = !root.files-open; }
                }
            }

            HorizontalLayout {
                alignment: center;
                Badge {
                    text: root.item.info;
                    kind: root.item.kind;
                }
            }
        }

        if root.files-open && root.item.files.length > 0: Rectangle {
            background: #80808010;
            border-radius: 4px;
            clip: true;
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 2px;
                for f in root.item.files: Rectangle {
                    height: 18px;
                    clip: true;
                    Text {
                        x: 0;
                        width: parent.width;
                        height: parent.height;
                        text: "📄 " + f;
                        font-size: 11px;
                        opacity: 0.9;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

export component SmartSyncWindow inherits Window {
    title: "RepoOrganizer – Smart-Sync";
    min-width: 760px;
    min-height: 520px;
    preferred-width: 860px;
    preferred-height: 640px;

    in property <int> sync-behind-count: 0;
    in property <int> sync-dirty-count: 0;
    in property <int> sync-ahead-count: 0;
    in property <int> sync-missing-bp-count: 0;
    in property <int> sync-alt-after-push-count: 0;
    in property <int> sync-alt-standalone-count: 0;

    in property <[SmartSyncDetailRow]> sync-pull-details;
    in property <[SmartSyncDetailRow]> sync-push-details;
    in property <[SmartSyncDetailRow]> sync-clone-details;
    in property <[SmartSyncDetailRow]> sync-alt-after-push-details;
    in property <[SmartSyncDetailRow]> sync-alt-standalone-details;

    in-out property <bool> sync-opt-pull: true;
    in-out property <bool> sync-opt-commit-push: true;
    in-out property <string> sync-commit-msg: "Smart-Sync Update";
    in-out property <bool> sync-opt-clone-missing: false;
    in-out property <bool> sync-opt-auto-sync: false;

    // Status-Ticker während und nach der Ausführung
    in property <bool> sync-running: false;
    in property <string> sync-ticker-title: "";
    in property <string> sync-ticker-detail: "";
    in property <int> sync-step-current: 0;
    in property <int> sync-step-total: 0;
    in property <[SmartSyncLogRow]> sync-ticker-log;
    in-out property <bool> ticker-log-open: true;

    property <int> push-total-count: root.sync-dirty-count + root.sync-ahead-count;
    property <bool> pull-active: root.sync-opt-pull && root.sync-behind-count > 0;
    property <bool> push-active: root.sync-opt-commit-push && root.push-total-count > 0;
    property <bool> clone-active: root.sync-opt-clone-missing && root.sync-missing-bp-count > 0;
    property <int> active-alt-count: root.sync-alt-standalone-count + (root.push-active ? root.sync-alt-after-push-count : 0);
    property <bool> alt-active: root.sync-opt-auto-sync && root.active-alt-count > 0;
    property <bool> has-inactive-options: !root.pull-active || !root.push-active || !root.clone-active || !root.alt-active;

    property <int> sync-selected-actions:
        (root.pull-active ? root.sync-behind-count : 0)
        + (root.push-active ? root.push-total-count : 0)
        + (root.clone-active ? root.sync-missing-bp-count : 0)
        + (root.alt-active ? root.active-alt-count : 0);

    public function apply-theme(t: string) {
        Palette.color-scheme = t == "dark" ? ColorScheme.dark : t == "light" ? ColorScheme.light : ColorScheme.unknown;
    }

    callback run-smart-sync(bool, bool, string, bool, bool);
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Kopfzeile
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "⚡ Smart-Sync: Alles intelligent synchronisieren";
                font-size: 18px;
                font-weight: 700;
                color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Schließen";
                clicked => { root.close-window(); }
            }
        }

        Text {
            text: "Aktive Synchronisationsschritte stehen oben samt betroffenen Pfaden. Dateilisten lassen sich bei Bedarf per Klick aufklappen.";
            font-size: 12px;
            opacity: 0.78;
            wrap: word-wrap;
        }

        // Hauptbereich: Aktive Optionen oben, inaktive Optionen unten
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                // === AKTIVE OPTIONEN (OBEN) ===

                // 1. Aktiv: Remote-Updates pullen
                if root.pull-active: Rectangle {
                    background: #2a7fd412;
                    border-width: 1px;
                    border-color: #2a7fd455;
                    border-radius: 6px;
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CheckBox {
                            text: "📥 Remote-Updates pullen (" + root.sync-behind-count + " Standort" + (root.sync-behind-count == 1 ? "" : "e") + " mit neuen Commits von Remote)";
                            checked <=> root.sync-opt-pull;
                            enabled: !root.sync-running && root.sync-behind-count > 0;
                        }
                        if root.sync-pull-details.length > 0: VerticalLayout {
                            padding-left: 24px;
                            spacing: 4px;
                            for item in root.sync-pull-details: SmartSyncDetailItem {
                                item: item;
                            }
                        }
                    }
                }

                // 2. Aktiv: Lokale Änderungen committen & pushen
                if root.push-active: Rectangle {
                    background: #d98e0412;
                    border-width: 1px;
                    border-color: #d98e0455;
                    border-radius: 6px;
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CheckBox {
                            text: "🚀 Lokale Änderungen committen & pushen (" + root.push-total-count + " Standort" + (root.push-total-count == 1 ? "" : "e") + " mit ungesendeten Änderungen)";
                            checked <=> root.sync-opt-commit-push;
                            enabled: !root.sync-running && root.push-total-count > 0;
                            toggled => {
                                if (root.sync-alt-standalone-count + (root.sync-opt-commit-push && root.push-total-count > 0 ? root.sync-alt-after-push-count : 0)) == 0 {
                                    root.sync-opt-auto-sync = false;
                                } else if root.sync-opt-commit-push && root.sync-alt-after-push-count > 0 {
                                    root.sync-opt-auto-sync = true;
                                }
                            }
                        }
                        VerticalLayout {
                            padding-left: 24px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Text { text: "Commit-Nachricht:"; vertical-alignment: center; font-size: 12px; font-weight: 600; opacity: 0.9; }
                                LineEdit {
                                    text <=> root.sync-commit-msg;
                                    enabled: !root.sync-running;
                                    placeholder-text: "Nachricht für die Commits (z. B. Smart-Sync Update)…";
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.sync-push-details.length > 0: VerticalLayout {
                                spacing: 4px;
                                for item in root.sync-push-details: SmartSyncDetailItem {
                                    item: item;
                                }
                            }
                        }
                    }
                }

                // 3. Aktiv: In fehlende Basispfade klonen
                if root.clone-active: Rectangle {
                    background: #2a7fd412;
                    border-width: 1px;
                    border-color: #2a7fd455;
                    border-radius: 6px;
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CheckBox {
                            text: "📁 In fehlende Basispfade klonen (" + root.sync-missing-bp-count + " fehlende" + (root.sync-missing-bp-count == 1 ? "r" : "") + " Standort" + (root.sync-missing-bp-count == 1 ? "" : "e") + " in RAM-Disk / SSD)";
                            checked <=> root.sync-opt-clone-missing;
                            enabled: !root.sync-running && root.sync-missing-bp-count > 0;
                        }
                        if root.sync-clone-details.length > 0: VerticalLayout {
                            padding-left: 24px;
                            spacing: 4px;
                            for item in root.sync-clone-details: SmartSyncDetailItem {
                                item: item;
                            }
                        }
                    }
                }

                // 4. Aktiv: Lokale Alternativpfade automatisch angleichen
                if root.alt-active: Rectangle {
                    background: #2e9e5b12;
                    border-width: 1px;
                    border-color: #2e9e5b55;
                    border-radius: 6px;
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        CheckBox {
                            text: "🔄 Lokale Alternativpfade (z. B. SSD ↔ RAM-Disk) automatisch angleichen (" + root.active-alt-count + " Standort" + (root.active-alt-count == 1 ? "" : "e") + ")";
                            checked <=> root.sync-opt-auto-sync;
                            enabled: !root.sync-running && root.active-alt-count > 0;
                        }
                        VerticalLayout {
                            padding-left: 24px;
                            spacing: 4px;
                            for item in root.sync-alt-standalone-details: SmartSyncDetailItem {
                                item: item;
                            }
                            if root.push-active: VerticalLayout {
                                spacing: 4px;
                                for item in root.sync-alt-after-push-details: SmartSyncDetailItem {
                                    item: item;
                                }
                            }
                        }
                    }
                }

                // === INAKTIVE / ABGEWÄHLTE OPTIONEN (UNTEN SORTIERT) ===
                if root.has-inactive-options: VerticalLayout {
                    spacing: 5px;
                    padding-top: 4px;

                    Text {
                        text: "Inaktive Optionen (abgewählt oder aktuell nichts zu tun):";
                        font-size: 11px;
                        font-weight: 600;
                        opacity: 0.6;
                    }

                    // Zuerst: Verfügbare, aber aktuell abgewählte Optionen (count > 0)
                    if !root.pull-active && root.sync-behind-count > 0: Rectangle {
                        height: 34px;
                        background: #8080800c;
                        border-width: 1px;
                        border-color: #80808028;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "📥 Remote-Updates pullen (" + root.sync-behind-count + " Standort" + (root.sync-behind-count == 1 ? "" : "e") + " verfügbar)";
                                checked <=> root.sync-opt-pull;
                                enabled: !root.sync-running;
                            }
                        }
                    }
                    if !root.push-active && root.push-total-count > 0: Rectangle {
                        height: 34px;
                        background: #8080800c;
                        border-width: 1px;
                        border-color: #80808028;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "🚀 Lokale Änderungen committen & pushen (" + root.push-total-count + " Standort" + (root.push-total-count == 1 ? "" : "e") + " verfügbar)";
                                checked <=> root.sync-opt-commit-push;
                                enabled: !root.sync-running;
                                toggled => {
                                    if (root.sync-alt-standalone-count + (root.sync-opt-commit-push && root.push-total-count > 0 ? root.sync-alt-after-push-count : 0)) == 0 {
                                        root.sync-opt-auto-sync = false;
                                    } else if root.sync-opt-commit-push && root.sync-alt-after-push-count > 0 {
                                        root.sync-opt-auto-sync = true;
                                    }
                                }
                            }
                        }
                    }
                    if !root.clone-active && root.sync-missing-bp-count > 0: Rectangle {
                        height: 34px;
                        background: #8080800c;
                        border-width: 1px;
                        border-color: #80808028;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "📁 In fehlende Basispfade klonen (" + root.sync-missing-bp-count + " fehlende" + (root.sync-missing-bp-count == 1 ? "r" : "") + " Standort" + (root.sync-missing-bp-count == 1 ? "" : "e") + " in RAM-Disk / SSD)";
                                checked <=> root.sync-opt-clone-missing;
                                enabled: !root.sync-running;
                            }
                        }
                    }
                    if !root.alt-active && root.active-alt-count > 0: Rectangle {
                        height: 34px;
                        background: #8080800c;
                        border-width: 1px;
                        border-color: #80808028;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "🔄 Lokale Alternativpfade (z. B. SSD ↔ RAM-Disk) automatisch angleichen (" + root.active-alt-count + " Standort" + (root.active-alt-count == 1 ? "" : "e") + " verfügbar)";
                                checked <=> root.sync-opt-auto-sync;
                                enabled: !root.sync-running;
                            }
                        }
                    }

                    // Ganz unten: Ausgegraute Optionen ohne anstehende Aufgaben (count == 0)
                    if root.sync-behind-count == 0: Rectangle {
                        height: 32px;
                        background: #80808006;
                        border-width: 1px;
                        border-color: #80808018;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "📥 Remote-Updates pullen (keine neuen Remote-Commits)";
                                checked: false;
                                enabled: false;
                            }
                        }
                    }
                    if root.push-total-count == 0: Rectangle {
                        height: 32px;
                        background: #80808006;
                        border-width: 1px;
                        border-color: #80808018;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "🚀 Lokale Änderungen committen & pushen (alles sauber & gepusht)";
                                checked: false;
                                enabled: false;
                            }
                        }
                    }
                    if root.sync-missing-bp-count == 0: Rectangle {
                        height: 32px;
                        background: #80808006;
                        border-width: 1px;
                        border-color: #80808018;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "📁 In fehlende Basispfade klonen (alle Basispfade vollständig)";
                                checked: false;
                                enabled: false;
                            }
                        }
                    }
                    if root.active-alt-count == 0: Rectangle {
                        height: 32px;
                        background: #80808006;
                        border-width: 1px;
                        border-color: #80808018;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            CheckBox {
                                text: "🔄 Lokale Alternativpfade (z. B. SSD ↔ RAM-Disk) automatisch angleichen (nichts anzugleichen)";
                                checked: false;
                                enabled: false;
                            }
                        }
                    }
                }
            }
        }

        // Kompakter, informativer Status-Ticker während und nach der Ausführung
        if root.sync-running || root.sync-ticker-title != "" || root.sync-ticker-log.length > 0: Rectangle {
            background: (Palette.color-scheme == ColorScheme.dark) ? #0f172a : #1e293b0d;
            border-width: 1px;
            border-color: root.sync-running ? #38bdf8aa : #2e9e5b77;
            border-radius: 6px;
            clip: true;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                // Einzeilige kompakte Status-Kopfzeile mit integriertem Fortschrittsbalken
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;

                    Text {
                        text: root.sync-ticker-title != "" ? root.sync-ticker-title : "Status-Ticker";
                        font-size: 12px;
                        font-weight: 700;
                        color: root.sync-running
                            ? ((Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8)
                            : #2e9e5b;
                        vertical-alignment: center;
                    }

                    if root.sync-ticker-detail != "": Rectangle {
                        horizontal-stretch: 1;
                        height: 24px;
                        clip: true;
                        Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: "·  " + root.sync-ticker-detail;
                            font-size: 11px;
                            opacity: 0.85;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.sync-ticker-detail == "": Rectangle { horizontal-stretch: 1; }

                    if root.sync-step-total > 0: HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            width: 72px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            background: #80808030;
                            border-radius: 3px;
                            clip: true;
                            Rectangle {
                                x: 0;
                                y: 0;
                                height: parent.height;
                                width: parent.width * Math.min(1.0, Math.max(0.0, root.sync-step-current / root.sync-step-total));
                                background: root.sync-running ? #2a7fd4 : #2e9e5b;
                                border-radius: 3px;
                            }
                        }
                        Badge {
                            text: root.sync-step-current + "/" + root.sync-step-total;
                            kind: root.sync-running ? 1 : 0;
                        }
                    }

                    if root.sync-ticker-log.length > 0: Rectangle {
                        height: 20px;
                        min-width: log-btn-txt.preferred-width + 12px;
                        background: log-ta.has-hover ? #80808030 : #80808018;
                        border-radius: 4px;
                        log-btn-txt := Text {
                            text: (root.ticker-log-open ? "▼ Details (" : "▶ Details (") + root.sync-ticker-log.length + ")";
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        log-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ticker-log-open = !root.ticker-log-open; }
                        }
                    }
                }

                // Kompakte mehrspaltige Detailtabelle (nutzt die volle Breite informativ aus)
                if root.ticker-log-open && root.sync-ticker-log.length > 0: Rectangle {
                    height: min(66px, max(20px, root.sync-ticker-log.length * 20px));
                    background: #8080800c;
                    border-radius: 4px;
                    clip: true;
                    ListView {
                        for entry in root.sync-ticker-log: HorizontalLayout {
                            height: 20px;
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text {
                                text: entry.state == 0 ? "⏳" : entry.state == 1 ? "✔" : "⚠";
                                color: Kinds.kind-color(entry.state == 0 ? 1 : entry.state == 1 ? 0 : 2);
                                width: 14px;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: entry.action;
                                font-size: 11px;
                                font-weight: 700;
                                width: 105px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: entry.repo;
                                font-size: 11px;
                                font-weight: 600;
                                width: 155px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: entry.path;
                                font-size: 11px;
                                opacity: 0.7;
                                width: 190px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 20px;
                                clip: true;
                                Text {
                                    x: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: entry.detail;
                                    font-size: 11px;
                                    opacity: 0.9;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Fußzeile mit Aktions-Buttons
        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Button {
                text: root.sync-running
                    ? "⏳ Synchronisiere…"
                    : ("🚀 Jetzt synchronisieren" + (root.sync-selected-actions > 0 ? (" (" + root.sync-selected-actions + " Aktionen)") : ""));
                primary: true;
                enabled: !root.sync-running && root.sync-selected-actions > 0;
                clicked => {
                    root.run-smart-sync(
                        root.pull-active,
                        root.push-active,
                        root.sync-commit-msg,
                        root.clone-active,
                        root.alt-active
                    );
                }
            }
            Button {
                text: "Schließen";
                clicked => { root.close-window(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "RepoOrganizer v0.1.0";
    min-width: 1080px;
    min-height: 680px;
    preferred-width: 1360px;
    preferred-height: 840px;

    in property <[RepoRow]> repos;
    in property <[LocationRow]> locations;
    in property <string> selected-id;
    in property <string> selected-name;
    in property <string> selected-remote;
    in property <string> suggested-remote;
    in property <string> selected-tags;
    in property <string> task-text: "Bereit";
    in property <bool> busy;
    in property <string> error-text;
    in property <[TaskRow]> tasks;
    in property <[ViewRow]> views;
    in property <[string]> view-options;
    in-out property <int> selected-view-index: 0;
    in property <bool> active-view-is-custom: false;
    in property <[InfoRow]> drift-rows;
    in property <[InfoRow]> health-rows;
    in property <string> health-text;
    in property <int> health-kind;
    in property <bool> health-busy;
    in-out property <int> detail-tab;
    in property <string> stat-text;
    in property <[BarItem]> stat-weeks;
    in property <[BarItem]> stat-months;
    in property <[HeatItem]> stat-heat;
    in property <[BarItem]> stat-authors;
    in property <bool> stat-busy;
    in-out property <bool> saving-view;
    in property <string> selected-notes;
    in property <bool> selected-favorite;
    in property <string> active-view;
    in-out property <bool> tasks-open: false;

    // Offline & Klonen
    in property <bool> selected-is-offline: false;
    in-out property <string> selected-suggested-dest: "";
    in-out property <string> new-location-path: "";
    in property <[MissingBasePathRow]> missing-base-paths;

    // Schnell-Commit & Push für aktiven Standort
    in property <string> selected-active-loc-id: "";
    in property <string> selected-active-loc-name: "";
    in property <int> selected-dirty-count: 0;
    in property <int> selected-ahead-count: 0;
    in property <int> selected-behind-count: 0;
    in property <[DirtyFileRow]> selected-dirty-files;
    in property <string> selected-dirty-summary: "";
    in property <string> selected-dirty-headline: "";
    in property <[DirtyLocFilterItem]> dirty-loc-options;
    in-out property <string> dirty-loc-filter: "all";
    in-out property <bool> show-dirty-files: false;

    // Dynamische Höhe des Detail-Panels & Aktivierung einzelner Detailansichten
    in-out property <length> detail-panel-height: 140px;
    in-out property <string> active-detail-location-id: "";
    in-out property <bool> all-locations-expanded: false;

    // Globaler Toolbar-Commit & Push
    in-out property <bool> quick-commit-open: false;
    in property <int> dirty-repos-count: 0;
    in property <string> quick-commit-target-id: "";
    in property <string> quick-commit-target-desc: "";

    // Smart-Sync Zähler für Toolbar
    in property <int> sync-total-actions: 0;
    in property <int> sync-behind-count: 0;
    in property <int> sync-dirty-count: 0;
    in property <int> sync-ahead-count: 0;
    in property <int> sync-missing-bp-count: 0;

    callback open-smart-sync();
    callback do-quick-commit-push(string);
    callback do-quick-commit(string);

    // Spalten-Filter & Sortierung im DataGrid-Kopf
    in-out property <int> col-repo-filter: 0;
    in-out property <int> col-status-filter: 0;
    in property <[string]> branch-options: ["Branch: Alle"];
    in-out property <string> col-branch-filter: "Branch: Alle";
    in-out property <int> col-commit-filter: 0;
    in-out property <int> col-remote-filter: 0;

    public function apply-theme(t: string) {
        Palette.color-scheme = t == "dark" ? ColorScheme.dark : t == "light" ? ColorScheme.light : ColorScheme.unknown;
    }

    callback refresh();
    callback select(string);
    callback filter-changed(string);
    callback column-filter-changed();
    callback derive-name(string) -> string;
    callback derive-url(string, string) -> string;
    callback add-repo(string, string, string);
    callback pull-repo(string);
    callback push-repo(string);
    callback reset-repo(string);
    callback commit-repo(string);
    callback location-action(string, string);
    callback commit(string, string);
    callback commit-and-push(string, string);
    callback filter-dirty-location(string);
    callback publish-remote(string, string, bool);
    callback publish-github(string, bool);
    callback open-url(string);
    callback fetch-all(string);
    callback load-stats(string, bool);
    callback select-view(string);
    callback add-view(string, string, string, string);
    callback delete-view(string);
    callback health-check(string);
    callback open-scan();
    callback open-settings();
    callback clone-repo(string, string);
    callback clone-location(string, string);
    callback clone-offline-location(string);
    callback browse-clone-dest();
    callback browse-new-location();
    callback link-location(string, string);
    callback open-in(string, string);
    callback delete-location(string);
    callback toggle-favorite(string);
    callback save-repo-meta(string, string, string, string);
    callback delete-repo(string);
    callback clean-repo-builds(string);
    callback clean-all-builds();
    callback create-in-base-path(string, string);
    callback open-file(string, string);
    callback open-file-in-code(string, string);
    in-out property <string> disk-info: "";

    property <bool> adding: false;
    property <bool> has-col-filter: root.col-repo-filter != 0 || root.col-status-filter != 0 || root.col-commit-filter >= 2 || root.col-remote-filter != 0 || (root.col-branch-filter != "" && root.col-branch-filter != "Branch: Alle");

    VerticalLayout {
        // Obere Haupt-App-Leiste: Titel, Ansichten-Auswahl und Werkzeuge
        Rectangle {
            height: 44px;
            background: #80808012;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;

                Text {
                    text: "📂 RepoOrganizer";
                    font-size: 16px;
                    font-weight: 800;
                    color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                    vertical-alignment: center;
                }

                Rectangle { width: 1px; height: 20px; background: #80808033; y: (parent.height - self.height) / 2; }

                Text {
                    text: "Ansicht:";
                    font-size: 12px;
                    font-weight: 700;
                    opacity: 0.85;
                    vertical-alignment: center;
                }

                ComboBox {
                    width: 220px;
                    model: root.view-options;
                    current-index <=> root.selected-view-index;
                    selected => {
                        if root.selected-view-index >= 0 && root.selected-view-index < root.views.length {
                            root.select-view(root.views[root.selected-view-index].key);
                        }
                    }
                }

                Button {
                    text: "+ Ansicht speichern…";
                    clicked => { root.saving-view = !root.saving-view; }
                }

                if root.active-view-is-custom: Button {
                    text: "🗑 Ansicht löschen";
                    clicked => {
                        if root.selected-view-index >= 0 && root.selected-view-index < root.views.length {
                            root.delete-view(root.views[root.selected-view-index].name);
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "🔍 Scan-Assistent…";
                    clicked => { root.open-scan(); }
                }
                Button {
                    text: "🧹 Builds leeren";
                    clicked => { root.clean-all-builds(); }
                }
                Button {
                    text: "⚙ Einstellungen…";
                    clicked => { root.open-settings(); }
                }
            }
        }

        Rectangle { height: 1px; background: #80808028; }

        // Hauptbereich
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            vertical-stretch: 1;

            if root.saving-view: Rectangle {
                background: (Palette.color-scheme == ColorScheme.dark) ? #1e293b : #2a7fd412;
                border-width: 1px;
                border-color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf866 : #2a7fd444;
                border-radius: 6px;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text { text: "Neue Ansicht speichern:"; font-weight: 700; font-size: 12px; vertical-alignment: center; }
                    vn := LineEdit { placeholder-text: "Name"; width: 140px; }
                    vt := LineEdit { placeholder-text: "Tags (z. B. work, tools)"; width: 160px; }
                    vs := LineEdit { placeholder-text: "Status: behind, dirty, …"; width: 160px; }
                    vd := LineEdit { placeholder-text: "älter als N Tage"; width: 100px; input-type: number; }
                    Button {
                        text: "Speichern";
                        primary: true;
                        enabled: vn.text != "";
                        clicked => {
                            root.add-view(vn.text, vt.text, vs.text, vd.text);
                            vn.text = ""; vt.text = ""; vs.text = ""; vd.text = "";
                            root.saving-view = false;
                        }
                    }
                    Button {
                        text: "Abbrechen";
                        clicked => { root.saving-view = false; }
                    }
                }
            }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "Suchen (Name, Tag, Remote)…";
                        edited(t) => { root.filter-changed(t); }
                    }
                    if root.has-col-filter: Button {
                        text: "Spaltenfilter zurücksetzen";
                        clicked => {
                            root.col-repo-filter = 0;
                            root.col-status-filter = 0;
                            root.col-branch-filter = "Branch: Alle";
                            if (root.col-commit-filter >= 2) { root.col-commit-filter = 0; }
                            root.col-remote-filter = 0;
                            root.column-filter-changed();
                        }
                    }
                    Button { text: root.busy ? "Aktualisiere…" : "Aktualisieren"; enabled: !root.busy; clicked => { root.refresh(); } }
                    Button { text: "Alle fetchen"; enabled: !root.busy; clicked => { root.fetch-all(""); } }
                    Button {
                        text: root.sync-total-actions > 0 ? ("⚡ Smart-Sync (" + root.sync-total-actions + ") 🔄") : "⚡ Smart-Sync 🔄";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.open-smart-sync(); }
                    }
                    Button { text: "Repo hinzufügen"; clicked => { root.adding = !root.adding; } }
                    Rectangle { width: 1px; height: 20px; background: #80808033; y: (parent.height - self.height) / 2; }
                    Button {
                        text: "Commit";
                        enabled: root.selected-id != "" && root.selected-dirty-count > 0 && !root.busy;
                        clicked => {
                            if root.detail-panel-height < 140px { root.detail-panel-height = 140px; }
                            root.detail-tab = 0;
                            root.commit-repo(root.selected-id);
                        }
                    }
                    Button {
                        text: "Reset";
                        enabled: root.selected-id != "" && root.selected-dirty-count > 0 && !root.busy;
                        clicked => { root.reset-repo(root.selected-id); }
                    }
                    Button {
                        text: root.selected-behind-count > 0 ? ("Pull (" + root.selected-behind-count + ")") : "Pull";
                        enabled: root.selected-id != "" && root.selected-behind-count > 0 && !root.busy;
                        primary: root.selected-behind-count > 0;
                        clicked => { root.pull-repo(root.selected-id); }
                    }
                    Button {
                        text: root.selected-ahead-count > 0 ? ("Push (" + root.selected-ahead-count + ")") : "Push";
                        enabled: root.selected-id != "" && root.selected-ahead-count > 0 && !root.busy;
                        primary: root.selected-ahead-count > 0;
                        clicked => { root.push-repo(root.selected-id); }
                    }
                    Button {
                        text: "Clean";
                        enabled: root.selected-id != "" && !root.busy;
                        clicked => { root.clean-repo-builds(root.selected-id); }
                    }
                    Rectangle { width: 1px; height: 20px; background: #80808033; y: (parent.height - self.height) / 2; }
                    Button {
                        text: root.detail-panel-height > 0px ? "Details ▼" : "Details ▲";
                        clicked => { root.detail-panel-height = root.detail-panel-height > 0px ? 0px : 140px; }
                    }
                }

                if root.adding: HorizontalLayout {
                    spacing: 8px;
                    name-edit := LineEdit {
                        placeholder-text: "Name";
                        horizontal-stretch: 1;
                        edited(n) => {
                            url-edit.text = root.derive-url(n, path-edit.text);
                        }
                    }
                    path-edit := LineEdit {
                        placeholder-text: "Lokaler Pfad des Klons (z. B. R:\\git\\Projekt)";
                        horizontal-stretch: 3;
                        edited(p) => {
                            if (name-edit.text == "") {
                                name-edit.text = root.derive-name(p);
                            }
                            url-edit.text = root.derive-url(name-edit.text, p);
                        }
                    }
                    url-edit := LineEdit {
                        placeholder-text: "Remote-URL (wird automatisch aus Git-User abgeleitet)";
                        horizontal-stretch: 3;
                    }
                    Button {
                        text: "Klonen";
                        enabled: url-edit.text != "" && path-edit.text != "";
                        clicked => {
                            root.clone-repo(url-edit.text, path-edit.text);
                            name-edit.text = "";
                            url-edit.text = "";
                            path-edit.text = "";
                            root.adding = false;
                        }
                    }
                    Button {
                        text: "Verknüpfen";
                        enabled: name-edit.text != "" && path-edit.text != "";
                        clicked => {
                            root.add-repo(name-edit.text, path-edit.text, url-edit.text);
                            name-edit.text = "";
                            url-edit.text = "";
                            path-edit.text = "";
                            root.adding = false;
                        }
                    }
                }

                if root.error-text != "": Text { text: root.error-text; color: #e04347; wrap: word-wrap; }

                // Repository-DataGrid (Spaltenköpfe als Filter-ComboBoxen + strukturierte Zeilen)
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: #80808030;
                    border-radius: 6px;
                    background: #80808008;
                    clip: true;

                    VerticalLayout {
                        // Tabellenkopf mit Filter-ComboBoxen
                        Rectangle {
                            height: 36px;
                            background: #80808022;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 3px;
                                padding-bottom: 3px;
                                spacing: 6px;

                                ComboBox {
                                    width: 185px;
                                    model: ["Repo: Alle", "★ Favoriten"];
                                    current-index <=> root.col-repo-filter;
                                    selected => { root.column-filter-changed(); }
                                }
                                ColSep {}
                                ComboBox {
                                    width: 175px;
                                    model: ["Status: Alle", "✓ Synchron", "↑ Zu senden (Push)", "↓ Zu holen (Pull)", "✎ Geändert (Lokal)", "📦 Mit Stash", "⇄ Divergiert", "💻 Nur lokal", "⭘ Offline", "⚠ Fehler"];
                                    current-index <=> root.col-status-filter;
                                    selected => { root.column-filter-changed(); }
                                }
                                ColSep {}
                                ComboBox {
                                    width: 95px;
                                    model: root.branch-options;
                                    current-value <=> root.col-branch-filter;
                                    selected => { root.column-filter-changed(); }
                                }
                                ColSep {}
                                ComboBox {
                                    width: 150px;
                                    model: ["Commit: Neueste ↓", "Commit: Älteste ↑", "Heute (24h)", "Letzte 7 Tage", "Letzte 30 Tage", "> 30 Tage alt"];
                                    current-index <=> root.col-commit-filter;
                                    selected => { root.column-filter-changed(); }
                                }
                                ColSep {}
                                Text { text: "Commits"; font-size: 11px; font-weight: 700; opacity: 0.85; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
                                ColSep {}
                                Text { text: "Dateien"; font-size: 11px; font-weight: 700; opacity: 0.85; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
                                ColSep {}
                                Text { text: "Git-Größe"; font-size: 11px; font-weight: 700; opacity: 0.85; width: 66px; horizontal-alignment: right; vertical-alignment: center; }
                                ColSep {}
                                Text { text: "Build-Größe"; font-size: 11px; font-weight: 700; opacity: 0.85; width: 68px; horizontal-alignment: right; vertical-alignment: center; }
                                ColSep {}
                                Text { text: "Orte"; font-size: 11px; font-weight: 700; opacity: 0.85; width: 36px; horizontal-alignment: center; vertical-alignment: center; }
                                ColSep {}
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: ["Hinweis / Remote: Alle", "💻 Nur lokal (kein Remote)", "🌐 Online (mit Remote)", "⚠ Mit Fehler", "⇄ Mit Drift"];
                                    current-index <=> root.col-remote-filter;
                                    selected => { root.column-filter-changed(); }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                width: parent.width;
                                background: #80808030;
                            }
                        }

                        if root.repos.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "Keine Repositories entsprechen den aktuellen Filtern.";
                                opacity: 0.6;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for repo[idx] in root.repos: Rectangle {
                                height: 36px;
                                z: (status-ta.has-hover || commit-ta.has-hover || locations-ta.has-hover) ? 100 : 0;
                                background: repo.id == root.selected-id
                                    ? #2a7fd42e
                                    : (rta.has-hover ? #80808020 : (Math.mod(idx, 2) == 1 ? #8080800c : transparent));

                                if repo.id == root.selected-id: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: #2a7fd4;
                                }

                                rta := TouchArea {
                                    clicked => { root.select(repo.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 6px;

                                    // 1. Repository Name
                                    Text {
                                        text: (repo.favorite ? "★ " : "") + repo.name;
                                        font-weight: repo.id == root.selected-id ? 700 : 600;
                                        font-size: 12px;
                                        width: 185px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    ColSep {}

                                    // 2. Status & Änderungen Badge (mit Hover-Dateiliste)
                                    status-box := Rectangle {
                                        width: 175px;
                                        height: parent.height;
                                        clip: false;

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            Badge {
                                                y: (parent.height - self.height) / 2;
                                                text: repo.status;
                                                kind: repo.kind;
                                            }
                                            if repo.dirty-count > 0: Text {
                                                text: "ℹ";
                                                font-size: 11px;
                                                font-weight: 700;
                                                opacity: status-ta.has-hover ? 1.0 : 0.45;
                                                color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                                                vertical-alignment: center;
                                            }
                                        }

                                        status-ta := TouchArea {
                                            mouse-cursor: pointer;
                                        }

                                        // Tooltip-Card mit Dateiliste beim Hovern
                                        if status-ta.has-hover && (repo.dirty-count > 0 || repo.dirty-files-preview != ""): Rectangle {
                                            x: 0px;
                                            y: idx < 2 ? 36px : -150px;
                                            width: 380px;
                                            height: 144px;
                                            z: 1000;
                                            background: (Palette.color-scheme == ColorScheme.dark) ? #1e293b : #ffffff;
                                            border-width: 1.5px;
                                            border-color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #2a7fd4;
                                            border-radius: 6px;
                                            drop-shadow-blur: 8px;
                                            drop-shadow-color: #00000060;
                                            drop-shadow-offset-y: 2px;

                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: repo.dirty-count > 0 ? ("✎ " + repo.dirty-count + " uncommittete Datei" + (repo.dirty-count == 1 ? "" : "en")) : "✓ Arbeitskopie ist sauber";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                                                        horizontal-stretch: 1;
                                                    }
                                                    if repo.stash-count > 0: Badge {
                                                        text: "📦 " + repo.stash-count + " Stash";
                                                        kind: 2;
                                                    }
                                                }

                                                Rectangle { height: 1px; background: #80808022; }

                                                Text {
                                                    text: repo.dirty-files-preview;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                    vertical-stretch: 1;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    ColSep {}

                                    // 3. Branch
                                    Text {
                                        text: repo.branch != "" ? ("⎇ " + repo.branch) : "–";
                                        font-size: 12px;
                                        width: 95px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    ColSep {}

                                    // 5. Letzter Commit (Hover & Klick für Details)
                                    commit-box := Rectangle {
                                        width: 150px;
                                        height: parent.height;
                                        clip: false;

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            Text {
                                                text: repo.last-commit;
                                                font-size: 12px;
                                                font-weight: commit-ta.has-hover ? 700 : 400;
                                                color: commit-ta.has-hover ? ((Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8) : (Palette.color-scheme == ColorScheme.dark ? #f1f5f9 : #0f172a);
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            if repo.last-commit-hash != "": Text {
                                                text: "ℹ";
                                                font-size: 11px;
                                                font-weight: 700;
                                                opacity: commit-ta.has-hover ? 1.0 : 0.4;
                                                color: commit-ta.has-hover ? #38bdf8 : #808080;
                                                vertical-alignment: center;
                                            }
                                        }

                                        commit-ta := TouchArea {
                                            mouse-cursor: pointer;
                                        }

                                        // Tooltip-Card mit Commit-Details beim Hovern
                                        if commit-ta.has-hover && repo.last-commit-hash != "": Rectangle {
                                            x: 0px;
                                            y: idx < 2 ? 36px : -94px;
                                            width: 350px;
                                            height: 90px;
                                            z: 1000;
                                            background: (Palette.color-scheme == ColorScheme.dark) ? #1e293b : #ffffff;
                                            border-width: 1.5px;
                                            border-color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #2a7fd4;
                                            border-radius: 6px;
                                            drop-shadow-blur: 8px;
                                            drop-shadow-color: #00000060;
                                            drop-shadow-offset-y: 2px;

                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "⎇ " + (repo.branch != "" ? repo.branch : "HEAD");
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Text {
                                                        text: "#" + repo.last-commit-hash;
                                                        font-size: 11px;
                                                        font-family: "monospace";
                                                        font-weight: 700;
                                                        color: (Palette.color-scheme == ColorScheme.dark) ? #94a3b8 : #64748b;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "👤 " + (repo.last-commit-author != "" ? repo.last-commit-author : "Unbekannt");
                                                        font-size: 11px;
                                                        opacity: 0.85;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Text {
                                                        text: "🕒 " + repo.last-commit + (repo.last-commit-time != "" ? (" · " + repo.last-commit-time) : "");
                                                        font-size: 11px;
                                                        opacity: 0.85;
                                                    }
                                                }

                                                Text {
                                                    text: repo.last-commit-msg != "" ? repo.last-commit-msg : "(Keine Commit-Nachricht)";
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    ColSep {}

                                    // 6. Anzahl Commits
                                    Text {
                                        text: repo.commits;
                                        font-size: 12px;
                                        width: 52px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    ColSep {}

                                    // 7. Anzahl Dateien
                                    Text {
                                        text: repo.files;
                                        font-size: 12px;
                                        width: 52px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    ColSep {}

                                    // 8. Git-Größe (.git)
                                    Text {
                                        text: repo.size;
                                        font-size: 11px;
                                        width: 66px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        color: repo.size-kind == 2 ? #e04347 : (repo.size-kind == 1 ? #d98e04 : #2e9e5b);
                                    }
                                    ColSep {}

                                    // 9. Build-Größe
                                    Text {
                                        text: repo.build-size != "" && repo.build-size != "-" && repo.build-size != "–" ? repo.build-size : "–";
                                        font-size: 11px;
                                        width: 68px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                        color: repo.build-kind == 2 ? #e04347 : (repo.build-kind == 1 ? #d98e04 : #80808088);
                                    }
                                    ColSep {}

                                    // 9. Orte (mit Hover-Pfadliste)
                                    locations-box := Rectangle {
                                        width: 36px;
                                        height: parent.height;
                                        clip: false;

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: repo.locations;
                                                font-size: 12px;
                                                font-weight: locations-ta.has-hover ? 700 : 400;
                                                color: locations-ta.has-hover ? ((Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8) : (Palette.color-scheme == ColorScheme.dark ? #f1f5f9 : #0f172a);
                                                vertical-alignment: center;
                                            }
                                        }

                                        locations-ta := TouchArea {
                                            mouse-cursor: pointer;
                                        }

                                        // Tooltip-Card mit Pfaden beim Hovern
                                        if locations-ta.has-hover && repo.locations-preview != "": Rectangle {
                                            x: -140px;
                                            y: idx < 2 ? 36px : -90px;
                                            width: 360px;
                                            min-height: 50px;
                                            z: 1000;
                                            background: (Palette.color-scheme == ColorScheme.dark) ? #1e293b : #ffffff;
                                            border-width: 1.5px;
                                            border-color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #2a7fd4;
                                            border-radius: 6px;
                                            drop-shadow-blur: 8px;
                                            drop-shadow-color: #00000060;
                                            drop-shadow-offset-y: 2px;

                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;

                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Text {
                                                        text: "📍 Speicherorte (" + repo.locations + ")";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: (Palette.color-scheme == ColorScheme.dark) ? #38bdf8 : #1d4ed8;
                                                    }
                                                }

                                                Rectangle { height: 1px; background: #80808022; }

                                                Text {
                                                    text: repo.locations-preview;
                                                    font-size: 11px;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                    ColSep {}

                                    // 10. Hinweis / Fehler / Remote-Feld
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        if repo.error-msg != "": Rectangle {
                                            background: #e0434722;
                                            border-color: #e0434788;
                                            border-width: 1px;
                                            border-radius: 4px;
                                            height: 22px;
                                            y: (parent.height - self.height) / 2;
                                            horizontal-stretch: 1;
                                            Text {
                                                x: 6px;
                                                width: parent.width - 12px;
                                                height: parent.height;
                                                text: "⚠ " + repo.error-msg;
                                                font-size: 11px;
                                                color: #e04347;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        if repo.error-msg == "" && repo.has-drift: Badge {
                                            text: "⇄ Drift";
                                            kind: 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if repo.error-msg == "" && repo.remote == "": Badge {
                                            text: "💻 Lokal";
                                            kind: 4;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if repo.error-msg == "": Text {
                                            text: (repo.tags != "" ? "[" + repo.tags + "]  " : "") + (repo.remote != "" ? repo.remote : "Kein Remote verbunden");
                                            font-size: 11px;
                                            opacity: 0.65;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        // Schnell-Aktionen in der Zeile: Commit, Reset, Pull, Push, Clean
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: end;
                                            Button {
                                                text: "Commit";
                                                enabled: repo.dirty-count > 0 && !root.busy;
                                                clicked => {
                                                    root.select(repo.id);
                                                    if root.detail-panel-height < 140px {
                                                        root.detail-panel-height = 140px;
                                                    }
                                                    root.detail-tab = 0;
                                                    root.commit-repo(repo.id);
                                                }
                                            }
                                            Button {
                                                text: "Reset";
                                                enabled: repo.dirty-count > 0 && !root.busy;
                                                clicked => { root.reset-repo(repo.id); }
                                            }
                                            Button {
                                                text: repo.behind-count > 0 ? ("Pull (" + repo.behind-count + ")") : "Pull";
                                                enabled: repo.remote != "" && repo.behind-count > 0 && !root.busy;
                                                clicked => { root.pull-repo(repo.id); }
                                            }
                                            Button {
                                                text: repo.ahead-count > 0 ? ("Push (" + repo.ahead-count + ")") : "Push";
                                                enabled: repo.remote != "" && repo.ahead-count > 0 && !root.busy;
                                                clicked => { root.push-repo(repo.id); }
                                            }
                                            Button {
                                                text: "Clean";
                                                enabled: repo.can-clean && !root.busy;
                                                clicked => { root.clean-repo-builds(repo.id); }
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    width: parent.width;
                                    background: #80808016;
                                }
                            }
                        }
                    }
                }
            }

            // Höhenverstellbarer Splitter-Balken zwischen Repo-Tabelle und Detailansicht
            Rectangle {
                height: 8px;
                background: splitter-ta.has-hover || splitter-ta.pressed ? #2a7fd455 : #80808020;
                clip: false;

                // Horizontale Griff-Markierung in der Mitte
                Rectangle {
                    width: 48px;
                    height: 4px;
                    background: splitter-ta.has-hover || splitter-ta.pressed ? #2a7fd4 : #80808066;
                    border-radius: 2px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                splitter-ta := TouchArea {
                    mouse-cursor: row-resize;
                    moved => {
                        if self.pressed {
                            let delta = self.mouse-y - self.pressed-y;
                            root.detail-panel-height = max(0px, min(root.height - 200px, root.detail-panel-height - delta));
                        }
                    }
                    double-clicked => {
                        if root.detail-panel-height < 60px {
                            root.detail-panel-height = 140px;
                        } else if root.detail-panel-height < 200px {
                            root.detail-panel-height = 280px;
                        } else {
                            root.detail-panel-height = 0px;
                        }
                    }
                }
            }

            // Unten: Detail-Panel über die volle Breite (ein-/ausblendbar)
            if root.detail-panel-height > 0px: Rectangle {
                height: root.detail-panel-height;
                background: #80808012;
                border-width: 1px;
                border-color: #80808028;
                clip: true;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 5px;
                    // Kopfzeile: Name, Remote, Favorit, Tabs
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.selected-id != "" ? root.selected-name : "Kein Repository ausgewählt";
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.selected-id != "": Button {
                            text: root.selected-favorite ? "★" : "☆";
                            clicked => { root.toggle-favorite(root.selected-id); }
                        }
                        Text {
                            text: root.selected-remote != "" ? root.selected-remote : (root.selected-id != "" ? "💻 Nur lokal (kein Remote)" : "");
                            font-size: 12px;
                            opacity: 0.7;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Button { text: "Standorte (" + root.locations.length + ")"; primary: root.detail-tab == 0; clicked => { root.detail-tab = 0; } }
                        Button {
                            text: "Änderungen" + (root.selected-dirty-files.length > 0 ? (" (" + root.selected-dirty-files.length + ")") : "");
                            primary: root.detail-tab == 5;
                            clicked => { root.detail-tab = 5; }
                        }
                        Button { text: "Drift (" + root.drift-rows.length + ")"; primary: root.detail-tab == 1; clicked => { root.detail-tab = 1; } }
                        Button { text: "Health"; primary: root.detail-tab == 2; clicked => { root.detail-tab = 2; } }
                        Button { text: "Statistik"; primary: root.detail-tab == 3; clicked => { root.detail-tab = 3; root.load-stats(root.selected-id, false); } }
                        Button { text: "Meta / Remote"; primary: root.detail-tab == 4; clicked => { root.detail-tab = 4; } }

                        // Schnelle Größenanpassung des Detail-Panels
                        Button {
                            text: "✕";
                            clicked => { root.detail-panel-height = 0px; }
                        }
                        Button {
                            text: "⯆";
                            clicked => { root.detail-panel-height = 110px; }
                        }
                        Button {
                            text: "⯀";
                            clicked => { root.detail-panel-height = 180px; }
                        }
                        Button {
                            text: "⯅";
                            clicked => { root.detail-panel-height = max(350px, root.height - 240px); }
                        }
                    }

                    // Trennlinie unter Kopfzeile
                    Rectangle {
                        height: 1px;
                        background: #80808028;
                    }

                    // Tab 0: Standorte auf voller Breite + Online-Stellen-Leiste bei lokalen Repos
                    if root.detail-tab == 0: VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;

                        // Falls das ausgewählte Repo noch keinen Remote hat: Direkt "Online stellen"-Leiste
                        if root.selected-id != "" && root.selected-remote == "": Rectangle {
                            background: #2a7fd418;
                            border-width: 1px;
                            border-color: #2a7fd466;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                spacing: 8px;
                                Text {
                                    text: "🌐 Online stellen:";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #2a7fd4;
                                    vertical-alignment: center;
                                }
                                pub-url := LineEdit {
                                    text: root.suggested-remote;
                                    placeholder-text: "Remote-URL (wird aus Git-User in Einstellungen abgeleitet, z. B. https://github.com/user/" + root.selected-name + ".git)…";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Remote verbinden & Pushen";
                                    primary: true;
                                    enabled: pub-url.text != "";
                                    clicked => {
                                        root.publish-remote(root.selected-id, pub-url.text, true);
                                    }
                                }
                                Button {
                                    text: "Nur Remote setzen";
                                    enabled: pub-url.text != "";
                                    clicked => {
                                        root.publish-remote(root.selected-id, pub-url.text, false);
                                    }
                                }
                                Button {
                                    text: "GitHub-Repo erstellen (Privat)";
                                    clicked => { root.publish-github(root.selected-id, true); }
                                }
                                Button {
                                    text: "GitHub (Öffentlich)";
                                    clicked => { root.publish-github(root.selected-id, false); }
                                }
                                Button {
                                    text: "GitHub ↗";
                                    clicked => { root.open-url("https://github.com/new"); }
                                }
                            }
                        }

                        // Schnell-Commit & Push: Automatische Erkennung des aktivsten/neuesten Standorts
                        if root.selected-id != "" && root.selected-dirty-count > 0: Rectangle {
                            background: #d98e041a;
                            border-width: 1px;
                            border-color: #d98e0477;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                Text {
                                    text: "✎ " + root.selected-dirty-count + " uncommittete Datei" + (root.selected-dirty-count == 1 ? "" : "en") + " in " + root.selected-active-loc-name + ":";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #d98e04;
                                    vertical-alignment: center;
                                }
                                fast-msg := LineEdit {
                                    placeholder-text: "Commit-Nachricht eingeben… (Enter für Commit & Push)";
                                    horizontal-stretch: 1;
                                    accepted => {
                                        if fast-msg.text != "" && root.selected-remote != "" {
                                            root.commit-and-push(root.selected-active-loc-id, fast-msg.text);
                                            fast-msg.text = "";
                                        }
                                    }
                                }
                                Button {
                                    text: "Commit & Push 🚀";
                                    primary: true;
                                    enabled: fast-msg.text != "" && root.selected-remote != "";
                                    clicked => {
                                        root.commit-and-push(root.selected-active-loc-id, fast-msg.text);
                                        fast-msg.text = "";
                                    }
                                }
                                Button {
                                    text: "Nur Commit";
                                    enabled: fast-msg.text != "";
                                    clicked => {
                                        root.commit(root.selected-active-loc-id, fast-msg.text);
                                        fast-msg.text = "";
                                    }
                                }
                            }
                        }

                        // Schnell-Push: Falls Commits ungesendet sind
                        if root.selected-id != "" && root.selected-dirty-count == 0 && root.selected-ahead-count > 0: Rectangle {
                            background: #2a7fd41a;
                            border-width: 1px;
                            border-color: #2a7fd477;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                Text {
                                    text: "↑ " + root.selected-ahead-count + " Commit" + (root.selected-ahead-count == 1 ? "" : "s") + " ungesendet in " + root.selected-active-loc-name + ":";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #2a7fd4;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Jetzt Pushen 🚀 (" + root.selected-ahead-count + ")";
                                    primary: true;
                                    enabled: root.selected-remote != "";
                                    clicked => {
                                        root.location-action(root.selected-active-loc-id, "push");
                                    }
                                }
                            }
                        }

                        // Angebot: Repo in fehlenden Basispfaden anlegen (z. B. RAM-Disk /r/git oder SSD ~/Projekte)
                        if root.selected-id != "" && root.missing-base-paths.length > 0: Rectangle {
                            background: #2a7fd415;
                            border-width: 1px;
                            border-color: #2a7fd455;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 8px;
                                Text {
                                    text: "📁 In Basispfad erstellen:";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #2a7fd4;
                                    vertical-alignment: center;
                                }
                                for mbp in root.missing-base-paths: Button {
                                    text: "+ " + mbp.label;
                                    primary: true;
                                    clicked => {
                                        root.create-in-base-path(root.selected-id, mbp.target-path);
                                    }
                                }
                                Text {
                                    text: "(klont automatisch & verknüpft neuen Standort)";
                                    font-size: 11px;
                                    opacity: 0.65;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        // Banner: Repo ist auf diesem Rechner noch offline
                        if root.selected-is-offline && root.selected-remote != "": Rectangle {
                            background: #2a7fd418;
                            border-color: #2a7fd4;
                            border-width: 1px;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Text {
                                    text: "📥 Auf diesem System nicht lokal vorhanden:";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #2a7fd4;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    text <=> root.selected-suggested-dest;
                                    placeholder-text: "Zielordner zum Klonen…";
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: "Ordner…";
                                    clicked => { root.browse-clone-dest(); }
                                }
                                Button {
                                    text: "Jetzt klonen";
                                    primary: true;
                                    enabled: root.selected-suggested-dest != "";
                                    clicked => { root.clone-location(root.selected-id, root.selected-suggested-dest); }
                                }
                            }
                        }

                        // Kopfzeile der Standorte mit Auf-/Zuklapp-Option
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "📁 Standorte & Pfade (" + root.locations.length + "):";
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if root.locations.length > 1: Button {
                                text: root.all-locations-expanded ? "Alle Details einklappen ▲" : "Alle Details ausklappen ▼";
                                clicked => {
                                    root.all-locations-expanded = !root.all-locations-expanded;
                                    if !root.all-locations-expanded {
                                        root.active-detail-location-id = "";
                                    }
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                for loc in root.locations: Rectangle {
                                    property <bool> is-active: root.all-locations-expanded || root.active-detail-location-id == loc.id;
                                    background: is-active ? #2a7fd418 : #8080800e;
                                    border-width: is-active ? 2px : 1px;
                                    border-color: is-active ? #2a7fd4cc : #80808022;
                                    border-radius: 7px;
                                    opacity: loc.other-os ? 0.5 : 1.0;
                                    VerticalLayout {
                                        padding: 7px;
                                        spacing: 6px;

                                        // Kompakte Pfadzeile: Immer sichtbar als Pfad-Eintrag
                                        HorizontalLayout {
                                            spacing: 8px;
                                            if is-active: Rectangle {
                                                width: 4px;
                                                height: 20px;
                                                background: #2a7fd4;
                                                border-radius: 2px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                Text {
                                                    x: 0;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: (is-active ? "📂 " : "📁 ") + loc.path;
                                                    font-size: is-active ? 14px : 13px;
                                                    font-weight: is-active ? 700 : 600;
                                                    color: is-active ? #2a7fd4 : (Palette.color-scheme == ColorScheme.dark ? #ffffff : #18181b);
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        if root.active-detail-location-id == loc.id {
                                                            root.active-detail-location-id = "";
                                                            root.all-locations-expanded = false;
                                                        } else {
                                                            root.active-detail-location-id = loc.id;
                                                        }
                                                    }
                                                }
                                            }
                                            if is-active: Badge {
                                                text: "Aktiv";
                                                kind: 1;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Badge { text: loc.status; kind: loc.kind; y: (parent.height - self.height) / 2; }
                                            if !loc.other-os && loc.kind != 4: Badge {
                                                text: loc.working-tree;
                                                kind: loc.working-tree-kind;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: loc.label + " (" + loc.role + ")";
                                                font-size: 11px;
                                                font-weight: is-active ? 600 : 400;
                                                opacity: is-active ? 0.95 : 0.7;
                                                vertical-alignment: center;
                                            }
                                            if loc.branch != "": Text {
                                                text: "⎇ " + loc.branch;
                                                font-size: 11px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            if loc.ahead > 0: Badge {
                                                text: "↑ " + loc.ahead;
                                                kind: 1;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if loc.behind > 0: Badge {
                                                text: "↓ " + loc.behind;
                                                kind: 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Button {
                                                text: is-active ? "Details schließen ▲" : "Details öffnen ▼";
                                                primary: is-active;
                                                clicked => {
                                                    if root.active-detail-location-id == loc.id {
                                                        root.active-detail-location-id = "";
                                                        root.all-locations-expanded = false;
                                                    } else {
                                                        root.active-detail-location-id = loc.id;
                                                    }
                                                }
                                            }
                                        }

                                        // Wenn aktiviert: Die volle strukturierte Detailansicht für diesen Standort
                                        if is-active: VerticalLayout {
                                            spacing: 6px;

                                            Rectangle { height: 1px; background: #80808018; }

                                            // Aktionen & Tools
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: "Aktionen für diesen Standort:";
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    opacity: 0.75;
                                                    vertical-alignment: center;
                                                }
                                                Rectangle { horizontal-stretch: 1; }

                                                if loc.other-os || loc.kind == 4: Button {
                                                    text: "📥 Klonen";
                                                    primary: true;
                                                    enabled: root.selected-remote != "";
                                                    clicked => { root.clone-offline-location(loc.id); }
                                                }
                                                if !loc.other-os && loc.kind != 4: HorizontalLayout {
                                                    spacing: 4px;
                                                    Button { text: "Fetch"; enabled: root.selected-remote != ""; clicked => { root.location-action(loc.id, "fetch"); } }
                                                    Button { text: loc.behind > 0 ? ("Pull (" + loc.behind + ") ↓") : "Pull"; primary: loc.behind > 0; enabled: loc.can-pull && root.selected-remote != ""; clicked => { root.location-action(loc.id, "pull"); } }
                                                    Button { text: loc.ahead > 0 ? ("Push (" + loc.ahead + ") ↑") : "Push"; primary: loc.ahead > 0 && loc.dirty == 0; enabled: loc.can-push && root.selected-remote != ""; clicked => { root.location-action(loc.id, "push"); } }
                                                    Button { text: "Stash"; enabled: loc.can-commit; clicked => { root.location-action(loc.id, "stash"); } }
                                                    if loc.stashes > 0: Button { text: "Pop (" + loc.stashes + ")"; clicked => { root.location-action(loc.id, "stash_pop"); } }
                                                    Rectangle { width: 1px; height: 18px; background: #80808033; y: (parent.height - self.height) / 2; }
                                                    Button { text: "Explorer"; clicked => { root.open-in(loc.id, "explorer"); } }
                                                    Button { text: "Terminal"; clicked => { root.open-in(loc.id, "terminal"); } }
                                                    Button { text: "VS Code"; clicked => { root.open-in(loc.id, "code"); } }
                                                    Rectangle { width: 1px; height: 18px; background: #80808033; y: (parent.height - self.height) / 2; }
                                                    if loc.can-clean: Button { text: "Clean (" + loc.build-size + ")"; clicked => { root.location-action(loc.id, "clean"); } }
                                                    Button { text: "×"; clicked => { root.delete-location(loc.id); } }
                                                }
                                            }

                                            // Sync-Zeiten & Build-Status
                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text { text: "Synchronisations-Status: Letzter Fetch: " + loc.fetched + " · Letzter Pull: " + loc.pulled + (loc.build-size != "-" && loc.build-size != "–" ? " · Build: " + loc.build-size : ""); font-size: 11px; opacity: 0.65; vertical-alignment: center; }
                                            }

                                            // Fehlermeldung falls vorhanden
                                            if loc.error-msg != "": Rectangle {
                                                background: #e0434718;
                                                border-width: 1px;
                                                border-color: #e0434755;
                                                border-radius: 6px;
                                                HorizontalLayout {
                                                    padding: 6px;
                                                    spacing: 10px;
                                                    Text {
                                                        text: "⚠ " + loc.error-msg;
                                                        font-size: 11px;
                                                        color: #e04347;
                                                        wrap: word-wrap;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "Als sicher zulassen (safe.directory)";
                                                        clicked => { root.location-action(loc.id, "trust"); }
                                                    }
                                                    Button {
                                                        text: "Besitz übernehmen (Ownership)";
                                                        clicked => { root.location-action(loc.id, "take_ownership"); }
                                                    }
                                                }
                                            }

                                            // Arbeitskopie / Uncommittete Änderungen
                                            if loc.can-commit: Rectangle {
                                                background: #d98e0412;
                                                border-width: 1px;
                                                border-color: #d98e0455;
                                                border-radius: 6px;
                                                VerticalLayout {
                                                    padding: 8px;
                                                    spacing: 6px;
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text {
                                                            text: "✎ Arbeitskopie (" + loc.dirty + " uncommittete Datei" + (loc.dirty == 1 ? "" : "en") + "):";
                                                            font-size: 12px;
                                                            font-weight: 700;
                                                            color: #d98e04;
                                                            vertical-alignment: center;
                                                        }
                                                        if loc.last-dirty-time != "": Text {
                                                            text: "· Letzte Änderung: " + loc.last-dirty-time;
                                                            font-size: 11px;
                                                            opacity: 0.85;
                                                            vertical-alignment: center;
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                        Button {
                                                            text: root.show-dirty-files ? "Dateien verbergen ▲" : ("Dateien anzeigen (" + loc.dirty + ") ▼");
                                                            clicked => { root.show-dirty-files = !root.show-dirty-files; }
                                                        }
                                                        Button {
                                                            text: "Detail-Tabelle →";
                                                            clicked => { root.detail-tab = 5; }
                                                        }
                                                    }

                                                    if root.show-dirty-files && loc.dirty-files.length > 0: VerticalLayout {
                                                        spacing: 3px;
                                                        Rectangle { height: 1px; background: #d98e0433; }
                                                        for file in loc.dirty-files: Rectangle {
                                                            height: 26px;
                                                            background: #8080800c;
                                                            border-radius: 4px;
                                                            HorizontalLayout {
                                                                padding-left: 6px;
                                                                padding-right: 6px;
                                                                spacing: 8px;
                                                                Badge {
                                                                    text: file.status-code;
                                                                    kind: file.kind;
                                                                    y: (parent.height - self.height) / 2;
                                                                }
                                                                Text {
                                                                    text: file.status;
                                                                    font-size: 11px;
                                                                    font-weight: 600;
                                                                    color: Kinds.kind-color(file.kind);
                                                                    vertical-alignment: center;
                                                                    width: 120px;
                                                                }
                                                                Text {
                                                                    text: file.path;
                                                                    font-size: 11px;
                                                                    horizontal-stretch: 1;
                                                                    overflow: elide;
                                                                    vertical-alignment: center;
                                                                }
                                                                if file.size-text != "": Text {
                                                                    text: file.size-text;
                                                                    font-size: 11px;
                                                                    opacity: 0.7;
                                                                    width: 60px;
                                                                    horizontal-alignment: right;
                                                                    vertical-alignment: center;
                                                                }
                                                                Text {
                                                                    text: file.mtime-text;
                                                                    font-size: 11px;
                                                                    opacity: 0.8;
                                                                    width: 180px;
                                                                    vertical-alignment: center;
                                                                }
                                                                Button {
                                                                    text: "Öffnen";
                                                                    clicked => { root.open-file(file.loc-id, file.path); }
                                                                }
                                                                Button {
                                                                    text: "Code";
                                                                    clicked => { root.open-file-in-code(file.loc-id, file.path); }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    Rectangle { height: 1px; background: #d98e0433; }

                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        msg := LineEdit {
                                                            placeholder-text: "Commit-Nachricht eingeben… (Enter für Commit & Push)";
                                                            horizontal-stretch: 1;
                                                            accepted => {
                                                                if msg.text != "" && root.selected-remote != "" {
                                                                    root.commit-and-push(loc.id, msg.text);
                                                                    msg.text = "";
                                                                }
                                                            }
                                                        }
                                                        Button {
                                                            text: "Commit";
                                                            enabled: msg.text != "";
                                                            clicked => { root.commit(loc.id, msg.text); msg.text = ""; }
                                                        }
                                                        Button {
                                                            text: "Commit & Push 🚀";
                                                            primary: true;
                                                            enabled: msg.text != "" && root.selected-remote != "";
                                                            clicked => { root.commit-and-push(loc.id, msg.text); msg.text = ""; }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Trennlinie vor Standort-Hinzufügen-Leiste
                        if root.selected-id != "": Rectangle {
                            height: 1px;
                            background: #80808028;
                        }

                        if root.selected-id != "": HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                text <=> root.new-location-path;
                                placeholder-text: "Weiteren Standort hinzufügen (lokaler Pfad)…";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Ordner…";
                                clicked => { root.browse-new-location(); }
                            }
                            Button {
                                text: "Verknüpfen";
                                enabled: root.new-location-path != "";
                                clicked => { root.link-location(root.selected-id, root.new-location-path); root.new-location-path = ""; }
                            }
                            Button {
                                text: "Klonen";
                                enabled: root.new-location-path != "" && root.selected-remote != "";
                                clicked => { root.clone-location(root.selected-id, root.new-location-path); root.new-location-path = ""; }
                            }
                            Button { text: "Alle Standorte fetchen"; enabled: root.selected-remote != ""; clicked => { root.fetch-all(root.selected-id); } }
                            Button { text: "Repo bereinigen"; clicked => { root.clean-repo-builds(root.selected-id); } }
                        }
                    }

                    // Tab 1: Drift
                    if root.detail-tab == 1: VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;
                        Text { text: root.drift-rows.length == 0 ? "Keine Abweichungen zwischen den Standorten." : "Abweichungen zwischen Standorten"; font-weight: 600; }
                        ListView {
                            for row in root.drift-rows: Rectangle {
                                height: 34px;
                                background: Kinds.kind-color(row.kind).with-alpha(0.12);
                                border-radius: 6px;
                                Text { x: 10px; width: parent.width - 20px; text: row.text; color: Kinds.kind-color(row.kind); vertical-alignment: center; font-size: 12px; }
                            }
                        }
                    }

                    // Tab 2: Health
                    if root.detail-tab == 2: VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: root.health-text; font-weight: 600; color: Kinds.kind-color(root.health-kind); vertical-alignment: center; horizontal-stretch: 1; }
                            Button { text: root.health-busy ? "Prüfe…" : "Dieses Repo prüfen"; enabled: !root.health-busy && root.selected-id != ""; clicked => { root.health-check(root.selected-id); } }
                            Button { text: "Alle Repos prüfen"; enabled: !root.health-busy; clicked => { root.health-check(""); } }
                        }
                        ListView {
                            for row in root.health-rows: Rectangle {
                                height: 36px;
                                background: Kinds.kind-color(row.kind).with-alpha(0.12);
                                border-radius: 6px;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    Text { text: row.label + ": " + row.text; color: Kinds.kind-color(row.kind); font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: "→ " + row.advice; font-size: 12px; opacity: 0.75; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                }
                            }
                        }
                    }

                    // Tab 3: Statistik
                    if root.detail-tab == 3: VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.stat-text; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: root.stat-busy ? "Lade…" : "Neu laden"; enabled: !root.stat-busy && root.selected-id != ""; clicked => { root.load-stats(root.selected-id, true); } }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            vertical-stretch: 1;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Commits / Woche"; font-size: 11px; font-weight: 600; }
                                BarChart { items: root.stat-weeks; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Commits / Monat"; font-size: 11px; font-weight: 600; }
                                BarChart { items: root.stat-months; bar-color: #2e9e5b; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Heatmap (52 Wochen)"; font-size: 11px; font-weight: 600; }
                                Heatmap { cells: root.stat-heat; }
                                Text { text: "Top-Autoren"; font-size: 11px; font-weight: 600; }
                                AuthorBars { items: root.stat-authors; }
                            }
                        }
                    }

                    // Tab 4: Meta & Remote-Verwaltung
                    if root.detail-tab == 4: VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Remote-URL:"; font-size: 12px; font-weight: 600; width: 90px; vertical-alignment: center; }
                            remote-edit := LineEdit {
                                text: root.selected-remote != "" ? root.selected-remote : root.suggested-remote;
                                placeholder-text: "z. B. https://github.com/user/repo.git";
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "Remote setzen & Pushen (-u origin)";
                                enabled: root.selected-id != "" && remote-edit.text != "";
                                clicked => { root.publish-remote(root.selected-id, remote-edit.text, true); }
                            }
                            Button {
                                text: "Auf GitHub veröffentlichen (Privat)";
                                enabled: root.selected-id != "";
                                clicked => { root.publish-github(root.selected-id, true); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Tags:"; font-size: 12px; font-weight: 600; width: 90px; vertical-alignment: center; }
                            tags-edit := LineEdit { text: root.selected-tags; placeholder-text: "z. B. rust, work"; width: 220px; }
                            Text { text: "Notizen:"; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            notes-edit := LineEdit { text: root.selected-notes; placeholder-text: "Notizen zum Repo…"; horizontal-stretch: 1; }
                            Button {
                                text: "Speichern";
                                primary: true;
                                enabled: root.selected-id != "";
                                clicked => { root.save-repo-meta(root.selected-id, remote-edit.text, tags-edit.text, notes-edit.text); }
                            }
                            Button {
                                text: "Repo entfernen";
                                enabled: root.selected-id != "";
                                clicked => { root.delete-repo(root.selected-id); }
                            }
                        }
                    }

                    // Tab 5: Uncommittete Änderungen (Dateien, Status, letzte Änderung, Aktionen)
                    if root.detail-tab == 5: VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 1;

                        // Zusammenfassungs- und Schnell-Commit-Banner
                        Rectangle {
                            background: root.selected-dirty-files.length > 0 ? #d98e0414 : #2e9e5b14;
                            border-width: 1px;
                            border-color: root.selected-dirty-files.length > 0 ? #d98e0455 : #2e9e5b55;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.selected-dirty-headline != "" ? root.selected-dirty-headline : (root.selected-dirty-files.length == 0 ? "✓ Arbeitsverzeichnis ist sauber (keine uncommitteten Änderungen)" : ("✎ " + root.selected-dirty-files.length + " uncommittete Datei" + (root.selected-dirty-files.length == 1 ? "" : "en") + " in " + root.selected-name));
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: root.selected-dirty-files.length == 0 ? #2e9e5b : #d98e04;
                                        vertical-alignment: center;
                                    }
                                    if root.selected-dirty-summary != "": Text {
                                        text: "· " + root.selected-dirty-summary;
                                        font-size: 11px;
                                        opacity: 0.85;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                // Standort-Filterleiste, falls Änderungen an mehreren Standorten existieren
                                if root.dirty-loc-options.length > 1: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Standort filtern:";
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        opacity: 0.85;
                                    }
                                    Button {
                                        text: "Alle Standorte";
                                        primary: root.dirty-loc-filter == "all" || root.dirty-loc-filter == "";
                                        clicked => {
                                            root.dirty-loc-filter = "all";
                                            root.filter-dirty-location("all");
                                        }
                                    }
                                    for loc in root.dirty-loc-options: Button {
                                        text: loc.label + " (" + loc.count + ")";
                                        primary: root.dirty-loc-filter == loc.id;
                                        clicked => {
                                            root.dirty-loc-filter = loc.id;
                                            root.filter-dirty-location(loc.id);
                                        }
                                    }
                                }

                                if root.selected-dirty-files.length > 0 && root.selected-active-loc-id != "": HorizontalLayout {
                                    spacing: 8px;
                                    tab5-msg := LineEdit {
                                        placeholder-text: "Commit-Nachricht eingeben… (Enter für Commit & Push)";
                                        horizontal-stretch: 1;
                                        accepted => {
                                            if tab5-msg.text != "" && root.selected-remote != "" {
                                                root.commit-and-push(root.selected-active-loc-id, tab5-msg.text);
                                                tab5-msg.text = "";
                                            }
                                        }
                                    }
                                    Button {
                                        text: "Commit & Push 🚀";
                                        primary: true;
                                        enabled: tab5-msg.text != "" && root.selected-remote != "";
                                        clicked => {
                                            root.commit-and-push(root.selected-active-loc-id, tab5-msg.text);
                                            tab5-msg.text = "";
                                        }
                                    }
                                    Button {
                                        text: "Nur Commit";
                                        enabled: tab5-msg.text != "";
                                        clicked => {
                                            root.commit(root.selected-active-loc-id, tab5-msg.text);
                                            tab5-msg.text = "";
                                        }
                                    }
                                    Button {
                                        text: "Stash";
                                        clicked => { root.location-action(root.selected-active-loc-id, "stash"); }
                                    }
                                }
                            }
                        }

                        // Dateitabelle
                        if root.selected-dirty-files.length > 0: Rectangle {
                            vertical-stretch: 1;
                            border-width: 1px;
                            border-color: #80808028;
                            border-radius: 6px;
                            background: #80808008;
                            clip: true;

                            VerticalLayout {
                                // Tabellenkopf
                                Rectangle {
                                    height: 28px;
                                    background: #80808018;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text { text: "Staging / Status"; font-size: 11px; font-weight: 700; width: 180px; vertical-alignment: center; }
                                        Text { text: "Dateipfad"; font-size: 11px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { text: "Standort"; font-size: 11px; font-weight: 700; width: 170px; vertical-alignment: center; }
                                        Text { text: "Größe"; font-size: 11px; font-weight: 700; width: 70px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: "Letzte Änderung"; font-size: 11px; font-weight: 700; width: 170px; vertical-alignment: center; }
                                        Text { text: "Aktion"; font-size: 11px; font-weight: 700; width: 110px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }

                                Rectangle { height: 1px; background: #80808024; }

                                // Dateiliste
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: start;
                                        for file in root.selected-dirty-files: Rectangle {
                                            height: 30px;
                                            background: #80808006;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 8px;
                                                HorizontalLayout {
                                                    width: 180px;
                                                    spacing: 6px;
                                                    Badge {
                                                        text: file.status-code;
                                                        kind: file.kind;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    Text {
                                                        text: file.status;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Kinds.kind-color(file.kind);
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                                Text {
                                                    text: file.path;
                                                    font-size: 12px;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: file.loc-label;
                                                    font-size: 11px;
                                                    opacity: 0.85;
                                                    width: 170px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: file.size-text;
                                                    font-size: 11px;
                                                    opacity: 0.7;
                                                    width: 70px;
                                                    horizontal-alignment: right;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: file.mtime-text;
                                                    font-size: 11px;
                                                    opacity: 0.85;
                                                    width: 170px;
                                                    vertical-alignment: center;
                                                }
                                                HorizontalLayout {
                                                    width: 110px;
                                                    spacing: 4px;
                                                    alignment: center;
                                                    Button {
                                                        text: "Öffnen";
                                                        clicked => { root.open-file(file.loc-id, file.path); }
                                                    }
                                                    Button {
                                                        text: "Code";
                                                        clicked => { root.open-file-in-code(file.loc-id, file.path); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Kompakter Fußbalken (32px), bei Bedarf aufklappbar
            Rectangle {
                height: root.tasks-open ? 140px : 32px;
                background: #80808018;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 4px;
                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;
                        Text { text: root.task-text; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if root.disk-info != "": Text { text: root.disk-info; font-size: 11px; opacity: 0.75; vertical-alignment: center; }
                        Button {
                            text: root.tasks-open ? "Protokoll ▼ (" + root.tasks.length + ")" : "Protokoll ▲ (" + root.tasks.length + ")";
                            clicked => { root.tasks-open = !root.tasks-open; }
                        }
                    }
                    if root.tasks-open: ListView {
                        for task in root.tasks: HorizontalLayout {
                            height: 20px;
                            spacing: 8px;
                            Text {
                                text: task.state == 0 ? "⏳" : task.state == 1 ? "✔" : "✖";
                                color: Kinds.kind-color(task.state == 0 ? 1 : task.state == 1 ? 0 : 3);
                                width: 18px;
                            }
                            Text { text: task.title; font-size: 12px; width: 240px; overflow: elide; }
                            Text { text: task.detail; font-size: 11px; opacity: 0.75; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
